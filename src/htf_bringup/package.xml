<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>htf_bringup</name>
  <version>0.1.0</version>
  <description>Top-level bringup for the HTF simulation stack — bridges PX4 SITL and Gazebo to ROS 2.</description>
  <maintainer email="autonomous.teamkaizen@gmail.com">HTF</maintainer>
  <license>MIT</license>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>f450_description</exec_depend>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_copyright</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
