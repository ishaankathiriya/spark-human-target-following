<?xml version="1.0"?>
<!--
  DJI F450 Quadrotor – xacro version
  Process with:  xacro f450_v2.urdf > f450_v2_expanded.urdf

  Coordinate convention: X = forward, Y = left, Z = up
  base_link origin: geometric center of the frame assembly

  Motor layout (viewed from above):
    [FL] CCW     [FR] CW
          \     /
           \   /
            [C]
           /   \
          /     \
    [RL] CW     [RR] CCW
-->
<robot name="dji_f450" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       MESH PATHS
       ================================================================ -->
  <xacro:property name="mesh_base"   value="package://f450_description/meshes"/>
  <xacro:property name="mesh_top"    value="${mesh_base}/top_plate.stl"/>
  <xacro:property name="mesh_bottom" value="${mesh_base}/bottom_plate.stl"/>
  <xacro:property name="mesh_arm"    value="${mesh_base}/arm.stl"/>
  <xacro:property name="mesh_motor"  value="${mesh_base}/motor.stl"/>
  <xacro:property name="mesh_prop"   value="${mesh_base}/propeller.stl"/>
  <xacro:property name="mesh_camera"   value="${mesh_base}/camera.STL"/>
  <xacro:property name="mesh_case"     value="${mesh_base}/case_intel_realsense_d435.stl"/>
  <xacro:property name="mesh_pixhawk"  value="${mesh_base}/pixhawk.STL"/>
  <xacro:property name="mesh_jetson"   value="${mesh_base}/jetson_orin_nano.stl"/>
  <xacro:property name="mesh_standoff" value="${mesh_base}/standoff.stl"/>
  <xacro:property name="mesh_gps"      value="${mesh_base}/gps.stl"/>

  <!-- SolidWorks exports STL in mm; URDF expects metres → scale = 0.001.
       If meshes appear the wrong size, flip this to "1 1 1". -->
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>


  <!-- ================================================================
       PROPERTIES  –  all physical constants in one place
       ================================================================ -->

  <!-- Frame -->
  <xacro:property name="body_xy"         value="0.100"/>  <!-- plate side length (m) -->
  <xacro:property name="body_z"          value="0.038"/>  <!-- actual span: top plate (z=+0.013) to bottom plate (z=-0.025) -->
  <xacro:property name="body_cz"         value="-0.006"/> <!-- COM z: midpoint between plates -->

  <!-- Arms (2212 frame arms) -->
  <xacro:property name="motor_to_center" value="0.225"/>  <!-- wheelbase / 2 (m) -->
  <xacro:property name="arm_length"      value="0.175"/>  <!-- external arm length (m) -->
  <xacro:property name="arm_width"       value="0.018"/>
  <xacro:property name="arm_height"      value="0.010"/>
  <!-- COM derived from mesh centroid after user-tuned visual transform -->
  <xacro:property name="arm_cx"          value="0.138"/>
  <xacro:property name="arm_cz"          value="0.000"/>  <!-- COM relative to joint frame (beam centre = joint origin) -->
  <xacro:property name="arm_z_joint"     value="0.009"/>  <!-- arm beam centre height above base_link origin -->

  <!-- Motors (Holybro 2216 brushless) -->
  <xacro:property name="motor_r"         value="0.014"/>  <!-- radius (m) -->
  <xacro:property name="motor_l"         value="0.044"/>  <!-- actual height from STL: Y range -2.5→41.5 mm -->
  <xacro:property name="motor_z_base"    value="0.010"/>  <!-- visual xyz_z offset (user-tuned); motor sits this far above joint -->

  <!-- Rotors (1045 prop: 10 in diameter ≈ 0.260 m span) -->
  <xacro:property name="rotor_r"         value="0.119"/>  <!-- radius (m) -->
  <xacro:property name="rotor_t"         value="0.003"/>  <!-- thin-disc collision thickness (m) -->
  <!-- Rotor joint: 1 mm above motor top face (motor_z_base + motor_l + gap) -->
  <xacro:property name="rotor_z_offset"  value="${motor_z_base + motor_l + 0.001}"/>

  <!-- Masses (kg) -->
  <xacro:property name="body_mass"       value="0.100"/>
  <xacro:property name="arm_mass"        value="0.045"/>
  <xacro:property name="motor_mass"      value="0.055"/>
  <xacro:property name="rotor_mass"      value="0.015"/>


  <!-- ================================================================
       INERTIA HELPER MACROS
       ================================================================ -->

  <!-- Solid box: long axis = X, width = Y, height = Z -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m/12*(y*y+z*z)}" ixy="0" ixz="0"
             iyy="${m/12*(x*x+z*z)}" iyz="0"
             izz="${m/12*(x*x+y*y)}"/>
  </xacro:macro>

  <!-- Solid cylinder: axis along Z -->
  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertia ixx="${m/12*(3*r*r+l*l)}" ixy="0" ixz="0"
             iyy="${m/12*(3*r*r+l*l)}" iyz="0"
             izz="${m/2*r*r}"/>
  </xacro:macro>


  <!-- ================================================================
       MATERIALS
       ================================================================ -->
  <material name="red">       <color rgba="0.85 0.08 0.08 1"/> </material>
  <material name="black">     <color rgba="0.10 0.10 0.10 1"/> </material>
  <material name="dark_gray"> <color rgba="0.22 0.22 0.22 1"/> </material>
  <material name="silver">    <color rgba="0.75 0.75 0.75 1"/> </material>
  <material name="green">     <color rgba="0.13 0.37 0.13 1"/> </material>


  <!-- ================================================================
       BASE LINK
       ================================================================ -->
  <link name="base_link">
    <inertial>
      <mass value="${body_mass}"/>
      <origin xyz="0 0 ${body_cz}" rpy="0 0 0"/>
      <xacro:box_inertia m="${body_mass}" x="${body_xy}" y="${body_xy}" z="${body_z}"/>
    </inertial>
    <!-- Top plate: STL is flat in XZ (Y=thickness). Rotate 90° about X → flat in XY (Z=thickness). -->
    <visual name="top_plate">
      <origin xyz="0 0 0.013" rpy="1.5708 0 0"/>
      <geometry><mesh filename="${mesh_top}" scale="${mesh_scale}"/></geometry>
      <material name="red"/>
    </visual>
    <!-- Bottom plate: same orientation as top plate. -->
    <visual name="bottom_plate">
      <origin xyz="0 0 -0.025" rpy="1.5708 0 0"/>
      <geometry><mesh filename="${mesh_bottom}" scale="${mesh_scale}"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <!-- Collision stays as a primitive box (mesh collision is expensive) -->
    <collision>
      <origin xyz="0 0 ${body_cz}" rpy="0 0 0"/>
      <geometry><box size="${body_xy} ${body_xy} ${body_z}"/></geometry>
    </collision>
  </link>


  <!-- ================================================================
       ARM ASSEMBLY MACRO
       Instantiates one arm + motor + rotor and their joints.

       params:
         prefix    – link/joint name suffix (e.g. front_right)
         yaw       – arm direction from +X axis in radians
         arm_color – material name for the arm visual
       ================================================================ -->
  <xacro:macro name="arm_assembly" params="prefix yaw arm_color">

    <!-- ARM LINK -->
    <link name="arm_${prefix}">
      <inertial>
        <mass value="${arm_mass}"/>
        <origin xyz="${arm_cx} 0 ${arm_cz}" rpy="0 0 0"/>
        <xacro:box_inertia m="${arm_mass}" x="${arm_length}" y="${arm_width}" z="${arm_height}"/>
      </inertial>
      <!-- Arm: STL Z = long axis. Combined rotation:
             Ry(+90°) aligns STL Z → local +X (outward),
             then Rx(-90°) corrects cross-section (= 90° CW about world y=x / local X).
             xyz shifts the mesh so its outer tip meets the motor joint and
             its height centres at bottom-plate level (-0.011 m). -->
      <visual>
        <origin xyz="0.139 0 0.005" rpy="-1.5708 3.1416 -4.712"/>
        <geometry><mesh filename="${mesh_arm}" scale="${mesh_scale}"/></geometry>
        <material name="${arm_color}"/>
      </visual>
      <!-- Collision stays as a primitive box -->
      <collision>
        <origin xyz="${arm_cx} 0 ${arm_cz}" rpy="0 0 0"/>
        <geometry><box size="${arm_length} ${arm_width} ${arm_height}"/></geometry>
      </collision>
    </link>

    <joint name="body_to_arm_${prefix}" type="fixed">
      <parent link="base_link"/>
      <child link="arm_${prefix}"/>
      <origin xyz="0 0 ${arm_z_joint}" rpy="0 0 ${yaw}"/>
    </joint>

    <!-- MOTOR LINK -->
    <link name="motor_${prefix}">
      <inertial>
        <mass value="${motor_mass}"/>
        <!-- COM = visual base offset + half motor height (from STL analysis) -->
        <origin xyz="0 0 ${motor_z_base + motor_l/2 - arm_z_joint}" rpy="0 0 0"/>
        <xacro:cylinder_inertia m="${motor_mass}" r="${motor_r}" l="${motor_l}"/>
      </inertial>
      <!-- Motor: STL cylinder axis is Y. Rotate 90° about X → cylinder axis becomes Z (upward). -->
      <visual>
        <origin xyz="0 0 ${0.010 - arm_z_joint}" rpy="1.5708 0 0"/>
        <geometry><mesh filename="${mesh_motor}" scale="${mesh_scale}"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <!-- Collision: cylinder centred at actual motor COM position -->
      <collision>
        <origin xyz="0 0 ${motor_z_base + motor_l/2 - arm_z_joint}" rpy="0 0 0"/>
        <geometry><cylinder radius="${motor_r}" length="${motor_l}"/></geometry>
      </collision>
    </link>

    <joint name="arm_to_motor_${prefix}" type="fixed">
      <parent link="arm_${prefix}"/>
      <child link="motor_${prefix}"/>
      <origin xyz="${motor_to_center} 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ROTOR LINK -->
    <link name="rotor_${prefix}">
      <inertial>
        <mass value="${rotor_mass}"/>
        <!-- COM = visual xyz_z (-0.013) + STL Y-centre (5 mm = 0.005 m after rotation) -->
        <origin xyz="0 0 ${-0.008}" rpy="0 0 0"/>
        <xacro:cylinder_inertia m="${rotor_mass}" r="${rotor_r}" l="${rotor_t}"/>
      </inertial>
      <!-- Propeller: STL is flat in XZ (Y=thickness). Rotate 90° about X → flat in XY (spins about Z). -->
      <visual>
        <origin xyz="0 0 ${-0.013}" rpy="1.5708 0 0"/>
        <geometry><mesh filename="${mesh_prop}" scale="${mesh_scale}"/></geometry>
        <material name="black"/>
      </visual>
      <!-- Collision: disc centred at actual propeller COM position -->
      <collision>
        <origin xyz="0 0 ${-0.008}" rpy="0 0 0"/>
        <geometry><cylinder radius="${rotor_r}" length="${rotor_t}"/></geometry>
      </collision>
    </link>

    <!-- Continuous joint – positive velocity = CCW from above.
         CW rotors (front_right, rear_left): command negative velocity.  -->
    <joint name="motor_to_rotor_${prefix}" type="continuous">
      <parent link="motor_${prefix}"/>
      <child link="rotor_${prefix}"/>
      <origin xyz="0 0 ${rotor_z_offset - arm_z_joint - 0.001}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

  </xacro:macro>


  <!-- ================================================================
       INSTANTIATE FOUR ARM ASSEMBLIES
         front_right:  yaw = -pi/4   (CW  rotor)
         front_left:   yaw = +pi/4   (CCW rotor)
         rear_left:    yaw = +3*pi/4 (CW  rotor)
         rear_right:   yaw = -3*pi/4 (CCW rotor)
       ================================================================ -->
  <xacro:arm_assembly prefix="front_right" yaw="${-pi/4}"    arm_color="red"/>
  <xacro:arm_assembly prefix="front_left"  yaw="${pi/4}"     arm_color="red"/>
  <xacro:arm_assembly prefix="rear_left"   yaw="${3*pi/4}"   arm_color="black"/>
  <xacro:arm_assembly prefix="rear_right"  yaw="${-3*pi/4}"  arm_color="black"/>


  <!-- ================================================================
       D435i RealSense Camera Mount  –  forward-facing, 0° tilt
       Mount bracket centre: x=0.060, z=-0.010 from base_link
       Camera link centre:   x≈0.083, z=-0.010 from base_link
       ================================================================ -->

  <!-- Mount bracket (physical envelope of the case) -->
  <xacro:property name="cam_mnt_m"  value="0.005"/>  <!-- 5 g plastic -->

  <!-- case_intel_realsense_d435.stl bounds: 80×49×33 mm.
       Visual is rendered with scale=0.001 and rpy="0 0 1.5708" (Rz +90°),
       which swaps the STL x/y axes in the link frame:
         fore-aft (link-X) ← STL-Y = 49 mm  → 0.049 m
         lateral  (link-Y) ← STL-X = 80 mm  → 0.080 m
         vertical (link-Z) ← STL-Z = 33 mm  → 0.033 m
       STL centroid (4.5, -13, 26) mm, after Rz and visual xyz offset (0.01, 0, -0.02):
         cx = (-(-0.013))      + 0.010 = 0.023 m
         cy = (  0.0045)       + 0.000 = 0.005 m
         cz = (  0.026)        - 0.020 = 0.006 m  -->
  <xacro:property name="cam_case_cx" value="0.023"/>
  <xacro:property name="cam_case_cy" value="0.005"/>
  <xacro:property name="cam_case_cz" value="0.006"/>
  <xacro:property name="cam_case_dx" value="0.049"/>
  <xacro:property name="cam_case_dy" value="0.080"/>
  <xacro:property name="cam_case_dz" value="0.033"/>

  <!-- D435i physical dimensions -->
  <xacro:property name="d435i_x"    value="0.025"/>
  <xacro:property name="d435i_y"    value="0.090"/>
  <xacro:property name="d435i_z"    value="0.025"/>
  <xacro:property name="d435i_mass" value="0.072"/>

  <!-- Camera mount / case — STL mesh replacing the placeholder box.
       rpy and xyz here are initial guesses; tune in RViz until the case
       sits correctly around the camera body. -->
  <link name="camera_mount">
    <inertial>
      <mass value="${cam_mnt_m}"/>
      <!-- COM at actual mesh centroid in link frame (see cam_case_c* properties above) -->
      <origin xyz="${cam_case_cx} ${cam_case_cy} ${cam_case_cz}" rpy="0 0 0"/>
      <xacro:box_inertia m="${cam_mnt_m}" x="${cam_case_dx}" y="${cam_case_dy}" z="${cam_case_dz}"/>
    </inertial>
    <visual>
      <origin xyz="0.01 0 -0.02" rpy="0 0 1.5708"/>
      <geometry><mesh filename="${mesh_case}" scale="${mesh_scale}"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <!-- Collision box centred on the actual mesh COM -->
    <collision>
      <origin xyz="${cam_case_cx} ${cam_case_cy} ${cam_case_cz}" rpy="0 0 0"/>
      <geometry><box size="${cam_case_dx} ${cam_case_dy} ${cam_case_dz}"/></geometry>
    </collision>
  </link>

  <joint name="body_to_camera_mount" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount"/>
    <origin xyz="0.060 0 -0.010" rpy="0 0 0"/>
  </joint>

  <!-- D435i camera body.
       camera.STL is in METRES (bounding box 90×25×25 mm), so scale="1 1 1".
       Visual origin tuned by user: xyz="0.009 -0.006 -0.005" rpy="-1.5708 0 -1.5708".
       COM derived from STL centroid (~0.005,-0.002,-0.015 m) rotated by Rz(-π/2)×Rx(-π/2):
         p_link = R·p_stl + xyz_offset = (-0.006, -0.011, -0.003) m  -->
  <link name="camera_link">
    <inertial>
      <mass value="${d435i_mass}"/>
      <origin xyz="-0.006 -0.011 -0.003" rpy="0 0 0"/>
      <xacro:box_inertia m="${d435i_mass}" x="${d435i_x}" y="${d435i_y}" z="${d435i_z}"/>
    </inertial>
    <visual>
      <origin xyz="0.009 -0.006 -0.005" rpy="-1.5708 0 -1.5708"/>
      <geometry><mesh filename="${mesh_camera}" scale="1 1 1"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <!-- Collision box centred on computed COM in link frame -->
    <collision>
      <origin xyz="-0.006 -0.011 -0.003" rpy="0 0 0"/>
      <geometry><box size="${d435i_x} ${d435i_y} ${d435i_z}"/></geometry>
    </collision>
  </link>

  <!-- Camera body sits inside the case; centre it on the case mesh centroid. -->
  <joint name="camera_mount_to_camera" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <origin xyz="${cam_case_cx} ${cam_case_cy} ${cam_case_cz}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frames  (ROS camera convention: z=into-scene, x=right, y=down)
       rpy="-pi/2 0 -pi/2" rotates body frame (x=fwd,y=left,z=up) to optical frame -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- D435i IMU frame (~20 mm behind lens centre, ~5 mm left) -->
  <link name="camera_imu_frame"/>
  <joint name="camera_imu_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_imu_frame"/>
    <origin xyz="-0.020 0.005 0" rpy="0 0 0"/>
  </joint>


  <!-- ================================================================
       BODY STACK: Pixhawk 2.4.8 → Standoffs → Upper Deck → Jetson
       Z reference from base_link origin:
         Top plate surface    : z = +0.013 m
         Pixhawk top face     : z = +0.013 + 0.016 = +0.029 m
         Standoff top / plate : z = +0.013 + 0.020 = +0.033 m
         Clearance above PX4  : 4 mm  (very tight — increase standoff_h if needed)
       ================================================================ -->

  <!-- Pixhawk 2.4.8 flight controller — dims from STL bounding box -->
  <xacro:property name="px4_x"          value="0.082"/>   <!-- STL Z span: 82 mm (length, fore-aft) -->
  <xacro:property name="px4_y"          value="0.050"/>   <!-- STL X span: 49.7 mm → 50 mm (width) -->
  <xacro:property name="px4_z"          value="0.016"/>   <!-- STL Y span: 16 mm (height) -->
  <xacro:property name="px4_mass"       value="0.038"/>   <!-- 38 g -->

  <!-- Aluminium M3 hex standoffs — dims from STL bounding box.
       Physical standoff height may differ; update standoff_h if so. -->
  <xacro:property name="standoff_r"      value="0.00346"/> <!-- circumscribed hex radius (3.464 mm) -->
  <xacro:property name="standoff_h"      value="0.020"/>   <!-- STL Z span: 20 mm height -->
  <!-- Standoffs placed at corners of a 80×80 mm square on the top plate -->
  <xacro:property name="standoff_spread" value="0.040"/>   <!-- ±40 mm from drone centre -->
  <!-- Mass: Al hex, V≈(3√3/2)×3.464²×20≈623 mm³ × 2.7 g/cm³ ≈ 1.7 g each → ~7 g total -->
  <xacro:property name="standoff_m_each" value="0.0017"/>

  <!-- Upper deck plate: same mesh as top plate, 50 g estimate -->
  <xacro:property name="plate2_mass"    value="0.050"/>
  <xacro:property name="plate2_t"       value="0.003"/>   <!-- 3 mm thickness -->

  <!-- ── Pixhawk 2.4.8 ─────────────────────────────────────────── -->
  <!-- STL axes: X=width(50mm), Y=height(16mm), Z=length(82mm).
       Rotation rpy="1.5708 0 1.5708" (Rz·Rx = [[0,0,1],[1,0,0],[0,1,0]]):
         body_X ← STL_Z (82mm, fore-aft), body_Y ← STL_X (50mm, lateral), body_Z ← STL_Y (16mm, up).
       xyz=(-0.041, -0.025, 0) centres the mesh in X/Y and places its base at z=0 (top plate surface). -->
  <link name="pixhawk_link">
    <inertial>
      <mass value="${px4_mass}"/>
      <origin xyz="0 0 ${px4_z/2}" rpy="0 0 0"/>
      <xacro:box_inertia m="${px4_mass}" x="${px4_x}" y="${px4_y}" z="${px4_z}"/>
    </inertial>
    <visual>
      <origin xyz="-0.041 -0.025 0" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="${mesh_pixhawk}" scale="${mesh_scale}"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${px4_z/2}" rpy="0 0 0"/>
      <geometry><box size="${px4_x} ${px4_y} ${px4_z}"/></geometry>
    </collision>
  </link>

  <!-- Bottom face of Pixhawk rests on top plate surface -->
  <joint name="body_to_pixhawk" type="fixed">
    <parent link="base_link"/>
    <child link="pixhawk_link"/>
    <origin xyz="0 0 0.013" rpy="0 0 0"/>
  </joint>

  <!-- ── Aluminium standoffs (4×, single link, 4 cylinder visuals) ─ -->
  <link name="standoff_assembly">
    <inertial>
      <mass value="${4 * standoff_m_each}"/>
      <!-- COM at mid-height of the 4-standoff cluster -->
      <origin xyz="0 0 ${standoff_h/2}" rpy="0 0 0"/>
      <!-- Box approximation spanning the full standoff footprint for inertia -->
      <xacro:box_inertia m="${4 * standoff_m_each}"
                          x="${2 * standoff_spread}"
                          y="${2 * standoff_spread}"
                          z="${standoff_h}"/>
    </inertial>
    <!-- STL origin is at the standoff base centre, Z runs 0→20mm up. No z-offset needed.
         Place each copy at the four corner positions (±40mm from drone centre). -->
    <!-- Front-left -->
    <visual name="standoff_fl">
      <origin xyz="${standoff_spread} ${standoff_spread} 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_standoff}" scale="${mesh_scale}"/></geometry>
      <material name="silver"/>
    </visual>
    <!-- Front-right -->
    <visual name="standoff_fr">
      <origin xyz="${standoff_spread} ${-standoff_spread} 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_standoff}" scale="${mesh_scale}"/></geometry>
      <material name="silver"/>
    </visual>
    <!-- Rear-left -->
    <visual name="standoff_rl">
      <origin xyz="${-standoff_spread} ${standoff_spread} 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_standoff}" scale="${mesh_scale}"/></geometry>
      <material name="silver"/>
    </visual>
    <!-- Rear-right -->
    <visual name="standoff_rr">
      <origin xyz="${-standoff_spread} ${-standoff_spread} 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_standoff}" scale="${mesh_scale}"/></geometry>
      <material name="silver"/>
    </visual>
    <!-- Collision: one box enclosing the 4 standoffs (self-collision is off by default) -->
    <collision>
      <origin xyz="0 0 ${standoff_h/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${2*standoff_spread} ${2*standoff_spread} ${standoff_h}"/>
      </geometry>
    </collision>
  </link>

  <!-- Standoffs also start at the top plate surface -->
  <joint name="body_to_standoffs" type="fixed">
    <parent link="base_link"/>
    <child link="standoff_assembly"/>
    <origin xyz="0 0 0.013" rpy="0 0 0"/>
  </joint>

  <!-- ── Upper deck plate (reuses top_plate mesh) ──────────────── -->
  <link name="second_plate_link">
    <inertial>
      <mass value="${plate2_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:box_inertia m="${plate2_mass}" x="${body_xy}" y="${body_xy}" z="${plate2_t}"/>
    </inertial>
    <!-- Same mesh and orientation as the main top plate; link origin is at plate centre -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><mesh filename="${mesh_top}" scale="${mesh_scale}"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_xy} ${body_xy} ${plate2_t}"/></geometry>
    </collision>
  </link>

  <!-- Top plate surface + full standoff height -->
  <joint name="body_to_second_plate" type="fixed">
    <parent link="base_link"/>
    <child link="second_plate_link"/>
    <origin xyz="0 0 ${0.013 + standoff_h}" rpy="0 0 0"/>
  </joint>

  <!-- ── Jetson Orin Nano Developer Kit ────────────────────────── -->
  <!-- STL bounding box (includes heatsink + connectors): 103 × 91 × 35 mm
       STL centroid: (46, 26.6, 12.5) mm; base (min-Z) at −4.9 mm.
       xyz=(-0.046, -0.027, 0.005) centres the mesh in X/Y and places its base at z=0
       (top surface of second_plate_link), rpy=(0,0,0) — already flat with Z up. -->
  <xacro:property name="jetson_x"    value="0.103"/>   <!-- STL X span -->
  <xacro:property name="jetson_y"    value="0.091"/>   <!-- STL Y span -->
  <xacro:property name="jetson_z"    value="0.035"/>   <!-- STL Z span -->
  <xacro:property name="jetson_mass" value="0.175"/>

  <link name="jetson_link">
    <inertial>
      <mass value="${jetson_mass}"/>
      <origin xyz="0 0 ${jetson_z/2}" rpy="0 0 0"/>
      <xacro:box_inertia m="${jetson_mass}" x="${jetson_x}" y="${jetson_y}" z="${jetson_z}"/>
    </inertial>
    <visual>
      <origin xyz="-0.046 -0.027 0.005" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_jetson}" scale="${mesh_scale}"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${jetson_z/2}" rpy="0 0 0"/>
      <geometry><box size="${jetson_x} ${jetson_y} ${jetson_z}"/></geometry>
    </collision>
  </link>

  <!-- Joint origin at top surface of second plate (plate2_t/2 above link origin) -->
  <joint name="second_plate_to_jetson" type="fixed">
    <parent link="second_plate_link"/>
    <child link="jetson_link"/>
    <origin xyz="0 0 ${plate2_t/2}" rpy="0 0 0"/>
  </joint>


  <!-- ================================================================
       BATTERY: Gen X Power 3300 mAh 4S LiPo, 14.8 V
       Mounted under the bottom plate (bottom plate surface: z = −0.025 m).
       Dimensions ESTIMATED from comparable 3300 mAh 4S packs —
       update batt_x/y/z/mass once you measure the physical battery.
       Long axis (138 mm) runs fore-aft (+X) to minimise CG shift.
       ================================================================ -->
  <xacro:property name="batt_x"    value="0.138"/>   <!-- 138 mm fore-aft (ESTIMATED) -->
  <xacro:property name="batt_y"    value="0.042"/>   <!-- 42 mm lateral   (ESTIMATED) -->
  <xacro:property name="batt_z"    value="0.028"/>   <!-- 28 mm height    (ESTIMATED) -->
  <xacro:property name="batt_mass" value="0.350"/>   <!-- 350 g           (ESTIMATED) -->

  <link name="battery_link">
    <inertial>
      <mass value="${batt_mass}"/>
      <!-- COM at geometric centre, which is batt_z/2 below the bottom plate surface -->
      <origin xyz="0 0 ${-batt_z/2}" rpy="0 0 0"/>
      <xacro:box_inertia m="${batt_mass}" x="${batt_x}" y="${batt_y}" z="${batt_z}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${-batt_z/2}" rpy="0 0 0"/>
      <geometry><box size="${batt_x} ${batt_y} ${batt_z}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-batt_z/2}" rpy="0 0 0"/>
      <geometry><box size="${batt_x} ${batt_y} ${batt_z}"/></geometry>
    </collision>
  </link>

  <!-- Joint at bottom plate surface; battery link origin here, block hangs below -->
  <joint name="body_to_battery" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0 0 -0.025" rpy="0 0 0"/>
  </joint>


  <!-- ================================================================
       GPS: Holybro M8N
         ∅50 mm disc × 14 mm tall, 32 g
       Mounted on an aluminium standoff mast that bolts through the rear-left
       M3 hole of the F450 top plate and the topmost plate, rising 10 mm
       above the topmost plate (second_plate_link at z=+0.033 m).

       Hole verified from STL: upper rear-left hole at STL (−31.72, −46.22) mm
         → URDF base_link frame (−0.032, +0.046) m, diameter ≈ 3.27 mm.
       Standoff r = 3 mm fits through the hole; height = 70 mm spans from
       (top plate surface z=0.013 m) to 13 mm above the Jetson top (z≈0.070 m).
       ================================================================ -->

  <!-- GPS standoff mast — same aluminium hex type as frame standoffs -->
  <xacro:property name="gps_mast_r"    value="0.003"/>   <!-- 3 mm radius (M3 hex standoff) -->
  <xacro:property name="gps_mast_h"    value="0.070"/>   <!-- 70 mm: clears Jetson top (z≈0.070 m) by ~13 mm -->
  <xacro:property name="gps_mast_x"    value="-0.032"/>  <!-- rear-left hole X in base_link frame -->
  <xacro:property name="gps_mast_y"    value="0.046"/>   <!-- rear-left hole Y in base_link frame -->
  <xacro:property name="gps_mast_mass" value="0.002"/>   <!-- 2 g estimate -->

  <link name="gps_mast_link">
    <inertial>
      <mass value="${gps_mast_mass}"/>
      <origin xyz="0 0 ${gps_mast_h/2}" rpy="0 0 0"/>
      <xacro:cylinder_inertia m="${gps_mast_mass}" r="${gps_mast_r}" l="${gps_mast_h}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${gps_mast_h/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${gps_mast_r}" length="${gps_mast_h}"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${gps_mast_h/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${gps_mast_r}" length="${gps_mast_h}"/></geometry>
    </collision>
  </link>

  <!-- Mast base sits on the F450 top plate surface (z = 0.013 m in base_link frame) -->
  <joint name="base_to_gps_mast" type="fixed">
    <parent link="base_link"/>
    <child link="gps_mast_link"/>
    <origin xyz="${gps_mast_x} ${gps_mast_y + 0.0038} 0.013" rpy="0 0 -1.5708"/>
  </joint>

  <!-- GPS disc -->
  <xacro:property name="gps_r"    value="0.025"/>   <!-- 25 mm radius -->
  <xacro:property name="gps_h"    value="0.014"/>   <!-- 14 mm height -->
  <xacro:property name="gps_mass" value="0.032"/>   <!-- 32 g -->

  <!-- STL axes: disc diameter in X (±25mm) and Z (±25mm); height in Y (−6→8.3mm).
       Rotation rpy="1.5708 0 0" (Rx+90°): body_X←STL_X, body_Y←−STL_Z, body_Z←STL_Y.
       Result: disc horizontal in body XY, height in body Z.
       xyz=(0, 0, 0.006) places disc bottom (STL_Y=−6mm) at z=0 (mast top surface).
       Collision uses cylinder primitive — STL includes a cable stub. -->
  <link name="gps_link">
    <inertial>
      <mass value="${gps_mass}"/>
      <origin xyz="0 0 ${gps_h/2}" rpy="0 0 0"/>
      <xacro:cylinder_inertia m="${gps_mass}" r="${gps_r}" l="${gps_h}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.006" rpy="1.5708 0 0"/>
      <geometry><mesh filename="${mesh_gps}" scale="${mesh_scale}"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${gps_h/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${gps_r}" length="${gps_h}"/></geometry>
    </collision>
  </link>

  <!-- GPS disc sits at the top of the mast -->
  <joint name="gps_mast_to_gps" type="fixed">
    <parent link="gps_mast_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 ${gps_mast_h}" rpy="0 0 0"/>
  </joint>


  <!-- ================================================================
       ESCs: Hobbywing XRotor 20A (4×, one per arm)
         52 × 22 × 7 mm, 14 g each
       Mounted on the UNDERSIDE of each arm beam.
       esc_pos_x is a PLACEHOLDER — tune once the ESCs are physically
       strapped to the arms.
       ================================================================ -->
  <xacro:property name="esc_x"     value="0.052"/>   <!-- 52 mm along arm axis -->
  <xacro:property name="esc_y"     value="0.022"/>   <!-- 22 mm lateral -->
  <xacro:property name="esc_z"     value="0.007"/>   <!-- 7 mm thick -->
  <xacro:property name="esc_mass"  value="0.014"/>   <!-- 14 g -->
  <!-- Distance from arm joint to ESC centre along arm axis (PLACEHOLDER) -->
  <xacro:property name="esc_pos_x" value="0.150"/>

  <!-- Macro: one ESC link + joint, parameterised by arm prefix -->
  <xacro:macro name="esc_assembly" params="prefix">
    <link name="esc_${prefix}">
      <inertial>
        <mass value="${esc_mass}"/>
        <!-- COM at geometric centre of the ESC block, below joint origin -->
        <origin xyz="0 0 ${-esc_z/2}" rpy="0 0 0"/>
        <xacro:box_inertia m="${esc_mass}" x="${esc_x}" y="${esc_y}" z="${esc_z}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${-esc_z/2}" rpy="0 0 0"/>
        <geometry><box size="${esc_x} ${esc_y} ${esc_z}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-esc_z/2}" rpy="0 0 0"/>
        <geometry><box size="${esc_x} ${esc_y} ${esc_z}"/></geometry>
      </collision>
    </link>

    <!-- Joint at bottom surface of arm beam; ESC block hangs below -->
    <joint name="arm_to_esc_${prefix}" type="fixed">
      <parent link="arm_${prefix}"/>
      <child link="esc_${prefix}"/>
      <origin xyz="${esc_pos_x} 0 ${-arm_height/2}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:esc_assembly prefix="front_right"/>
  <xacro:esc_assembly prefix="front_left"/>
  <xacro:esc_assembly prefix="rear_left"/>
  <xacro:esc_assembly prefix="rear_right"/>


</robot>
